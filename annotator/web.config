<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Revalidation a chaque chargement (reponse 304 si rien n'a change) :
           une mise a jour de l'outil est vue tout de suite, sans Ctrl+F5. -->
      <clientCache cacheControlMode="DisableCache" />
      <!-- remove puis mimeMap : evite l'erreur 500 si le type existe deja au niveau serveur -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
